# Copy to `.env`. Never commit a filled `.env`. Names + where to get values: docs/ENV.md

# Hugging Face (gated LTX / Krea licenses already accepted)
HF_TOKEN=
HUGGING_API_KEY=

# Cloudflare R2 — bucket `comfy`
R2_BUCKET=comfy
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ACCOUNT_ID=

# RunPod
RUNPOD_API_KEY=
RUNPOD_KREA_ENDPOINT_ID=i3fvrhucaici89
RUNPOD_QWEN_ENDPOINT_ID=ko6zewns6wj3mj
RUNPOD_CPU_ENDPOINT_ID=rydclpv4ta6u4p

# OpenRouter — option + fallback only. Cap the key. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=meta/muse-image
OPENROUTER_FLUX_MODEL=black-forest-labs/flux.2-klein-4b
OPENROUTER_VIDEO_MODEL=bytedance/seedance-1-5-pro

# ai33pro voice — https://ai33.pro/app/api-document  (send as header xi-api-key)
AI33_API_KEY=
AI33_BASE_URL=https://api.ai33.pro
AI33_IMAGE_MODEL=bytedance-seedream-4.5

# Phase C — Modal LTX (token from `modal token new` / dashboard). Empty until then.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Phase D — backend. Empty until owner says go.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
# URL-encode special chars in the password (? # @ etc). Connect → ORM → Prisma in Supabase.
DATABASE_URL=
# Session-mode pooler — migrations / psql
DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=
# Public frontend build setting. Production defaults to this value if omitted.
VITE_API_ORIGIN=https://api.marketingstudioie.site
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase E — live (spec 19). API_KEY = PWA clientId, SECRET = PWA Secret Key (HMAC),
# CLIENT_SECRET = OAuth client secret (API token endpoint), PWA_URL optional override.
SWICHNOW_API_KEY=
SWICHNOW_SECRET=
SWICHNOW_CLIENT_SECRET=
SWICHNOW_BASE_URL=https://sandbox-api.swichnow.com
SWICHNOW_PWA_URL=
# Swich merchant portal login (not used by the app — keep out of git)
SWICHNOW_PORTAL_USERNAME=
SWICHNOW_PORTAL_PASSWORD=
SWICHNOW_PORTAL_URL=https://portal.swichnow.com/

# Project scripts and stock (owner supplies values in .env)
OPENROUTER_TEXT_MODEL=
PEXELS_API_KEY=

# MCP agent connector (optional). Empty = open on this host. Never commit the value.
MCP_TOKEN=
