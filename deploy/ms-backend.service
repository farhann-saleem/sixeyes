[Unit]
Description=Marketing Studio API and frontend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=msapp
Group=msapp
WorkingDirectory=/opt/marketing-studio/current/apps/backend
ExecStart=/usr/bin/node --import tsx src/index.ts
EnvironmentFile=/opt/marketing-studio/current/revision.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=FRONTEND_URL=https://www.marketingstudioie.site
Environment=PORT=3001
Environment=DATA_DIR=/opt/marketing-studio/shared/data
Environment=NODE_OPTIONS=--max-old-space-size=384
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/marketing-studio/shared/data
UMask=0077

[Install]
WantedBy=multi-user.target
